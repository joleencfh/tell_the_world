# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @defaultRequired=infer @defaultSensitive=false
# @generateTsTypes(path=env.d.ts)
# ----------

# Supabase
# ---
# @required @type=url
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (public) key, shipped to the browser
# @required
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Bypasses RLS, server-only
# @required @sensitive
SUPABASE_SERVICE_ROLE_KEY=
# Only needed to regenerate DB types and apply migrations
# @optional @sensitive
SUPABASE_ACCESS_TOKEN=

# Email
# ---
# @required @sensitive
RESEND_API_KEY=
# Falls back to Resend's shared test sender (see lib/email/resend.ts)
# @optional
EMAIL_FROM=
# @required @type=email
ADMIN_EMAIL=

# Playwright test accounts
# ---
# @optional @type=email
TEST_CREATOR_EMAIL=
# @optional @type=email
TEST_EXPERT_EMAIL=
# @optional @type=email
TEST_ADMIN_EMAIL=

# Runtime flags
# ---
# @optional
CI=
# @optional @type=enum(development, production, test)
NODE_ENV=
# Opt-in rate-limit e2e test
# @optional
RATE_LIMIT_E2E=
