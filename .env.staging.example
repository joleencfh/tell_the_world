# Copy to .env.staging (git-ignored) and fill in the STAGING project values.
# Run the suite against staging with: bun run test:staging
# Never put production values in this file.

# Makes the Playwright global setup refuse to run against production
STAGING_ONLY=1

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Personal access token; works for every project you own. Used by migrate.ts
SUPABASE_ACCESS_TOKEN=

# Throwaway emails: no real inboxes should ever receive staging mail
RESEND_API_KEY=
ADMIN_EMAIL=playwright-test-admin@example.com
TEST_ADMIN_EMAIL=playwright-test-admin@example.com
TEST_CREATOR_EMAIL=playwright-test-creator@example.com
TEST_EXPERT_EMAIL=playwright-test-expert@example.com
